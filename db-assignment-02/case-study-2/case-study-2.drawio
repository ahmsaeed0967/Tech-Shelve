    <mxCell id="LEGEND" value="&lt;b&gt;LEGEND (Elmasri/Navathe notation)&lt;/b&gt;&lt;br&gt;Rectangle = entity / subclass&lt;br&gt;Diamond = relationship&lt;br&gt;Oval = attribute; underlined = primary key&lt;br&gt;Oval under oval = part of a composite attribute&lt;br&gt;Double oval = multivalued attribute&lt;br&gt;Dashed oval = derived attribute (not stored)&lt;br&gt;Double rectangle = weak entity; double diamond = identifying relationship&lt;br&gt;Dashed underline = partial key of a weak entity&lt;br&gt;Circle d = disjoint, o = overlapping&lt;br&gt;Double line = total specialization (single = partial)&lt;br&gt;Cup on line = subset (subclass is a subset of superclass)&lt;br&gt;(min,max) next to an entity = times ONE entity takes part;  N = many" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1230" y="918" width="400" height="265" as="geometry"/></mxCell>
