    <mxCell id="LEGEND" value="&lt;b&gt;LEGEND (Elmasri/Navathe notation)&lt;/b&gt;&lt;br&gt;&amp;#9645; Rectangle = entity / subclass&lt;br&gt;&amp;#9671; Diamond = relationship&lt;br&gt;&amp;#11053; Oval = attribute; &lt;u&gt;underlined&lt;/u&gt; = primary key&lt;br&gt;&amp;#11053;&amp;#11053; Double oval = multivalued attribute&lt;br&gt;Oval under oval = component of composite attribute&lt;br&gt;&amp;#9675; &lt;b&gt;d&lt;/b&gt; = disjoint, &lt;b&gt;o&lt;/b&gt; = overlapping&lt;br&gt;&amp;#9553; Double line = total specialization&lt;br&gt;&amp;#8746; (cup on line) = subset: subclass &amp;#8834; superclass&lt;br&gt;(min,max) next to an entity = how many times it takes part in that relationship&lt;br&gt;N = many (no upper limit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="50" y="785" width="340" height="230" as="geometry"/></mxCell>
